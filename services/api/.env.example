# ─── Required in production (loadEnv() will refuse to start without these) ────
DATABASE_URL="postgresql://user:password@localhost:5432/genemap"
# Each of the three secrets below MUST be at least 32 characters of
# random data in production. Generate with:  openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_32_PLUS_CHAR_RANDOM_STRING"
JWT_REFRESH_SECRET="REPLACE_WITH_32_PLUS_CHAR_RANDOM_STRING"
COOKIE_SECRET="REPLACE_WITH_32_PLUS_CHAR_RANDOM_STRING"
CORS_ORIGINS="http://localhost:5173,https://yourdomain.com"

# ─── Cross-site cookie behaviour (Vercel web ↔ Railway API) ────────────────────
# When the web app and API are served from DIFFERENT registrable domains (the
# production topology: web on Vercel, API on Railway), the browser will only
# send auth cookies on the SPA's XHR if they are SameSite=None; Secure. Set this
# to "true" in that deployment. Leave unset (SameSite=Lax) for same-origin /
# reverse-proxy deploys and local dev. See src/utils/cookies.js.
CROSS_ORIGIN_COOKIES="true"
# Optional: scope auth cookies to a shared parent domain when web + API live on
# sibling subdomains (e.g. app.example.com + api.example.com -> ".example.com").
# COOKIE_DOMAIN=".example.com"

# ─── Sensitive data encryption ────────────────────────────────────────────────
# 32-byte (64 hex chars) AES-256-GCM key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production REFUSES to write or read medical data without this set.
MEDICAL_DATA_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARS"

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_PRICE_MONTHLY="price_monthly_id"
STRIPE_PRICE_YEARLY="price_yearly_id"
STRIPE_PRICE_TEAM_MONTHLY="price_team_monthly_id"
STRIPE_PRICE_TEAM_YEARLY="price_team_yearly_id"
STRIPE_PRICE_DEPT_MONTHLY="price_dept_monthly_id"
STRIPE_PRICE_DEPT_YEARLY="price_dept_yearly_id"
STRIPE_PRICE_ENT_MONTHLY="price_ent_monthly_id"
STRIPE_PRICE_ENT_YEARLY="price_ent_yearly_id"

# ─── Restore-independent account-deletion ledger ─────────────────────────────
# Production account deletion fails closed until an owner-controlled HTTPS
# ledger can accept idempotent HMAC-signed tombstones and return an HMAC-signed
# JSON acknowledgement for the exact receipt. During a quarantined restore it
# must return an HMAC-signed JSON tombstone list. The transport secret must
# contain at least 32 random characters.
ACCOUNT_CLOSURE_LEDGER_WRITE_URL="https://ledger.example.com/tombstones/write"
ACCOUNT_CLOSURE_LEDGER_READ_URL="https://ledger.example.com/tombstones/read"
ACCOUNT_CLOSURE_LEDGER_SECRET="REPLACE_WITH_32_PLUS_CHAR_RANDOM_TRANSPORT_SECRET"
# Ordered key ring: current write key first, then retained read-only keys.
# Format: key-id=32-plus-character-secret,key-id=32-plus-character-secret
# Rotate by prepending a new ID/key and retaining every old key until all
# backups/tombstones governed by it have expired and a reconciliation drill is
# recorded. Keep this separate from ACCOUNT_CLOSURE_LEDGER_SECRET.
ACCOUNT_CLOSURE_LEDGER_IDENTITY_KEYS="2026-08=REPLACE_WITH_32_PLUS_CHAR_CURRENT_IDENTITY_KEY,2026-01=REPLACE_WITH_32_PLUS_CHAR_RETIRED_IDENTITY_KEY"

# ─── LLM providers (at least one is required in production unless the key
# presence check is deliberately skipped for a provider-disabled recovery) ────
OPENAI_API_KEY="sk-your-openai-api-key"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"
LLM_TEXT_PROVIDER="openai"
LLM_IMAGE_PROVIDER="openai"
LLM_TIMEOUT_MS="30000"

# Emergency circuit breaker for every generated research/learning publication.
# Normal production MUST be 0. Setting 1 makes /llm/* return 503 before quota
# accounting, resolver work, or provider access; /readyz reports degraded with
# modelPublication.status=disabled_for_safe_recovery.
DISABLE_MODEL_PUBLICATION="0"

# SKIP_LLM_KEY_CHECK only permits startup without provider keys. It does NOT by
# itself declare the product healthy or replace DISABLE_MODEL_PUBLICATION on a
# release that supports the circuit breaker.
# SKIP_LLM_KEY_CHECK="1"
# Retry backoff base for transient provider errors (ms). Default 150.
# LLM_RETRY_BASE_MS="150"
# Education routes use a smaller/faster model + tighter timeout so long
# single-shot generations return inside the gateway window. Defaults:
# gpt-4o-mini @ 24000ms for OpenAI; provider default otherwise.
# LLM_EDU_TEXT_MODEL="gpt-4o-mini"
# LLM_EDU_TIMEOUT_MS="24000"
# Allow raw VCF/genomic file content in LLM requests (off by default; also
# requires a per-user genomic_llm_upload consent record when enabled).
# ALLOW_GENOMIC_LLM_UPLOAD="false"
# LLM input-size ceilings (characters). These bound cost/DoS, not model
# capability — the models accept far more. Defaults leave ample headroom for
# context-enriched prompts (medical data, cohort stats). Raise if legitimate
# prompts are being rejected. See services/api/src/config/llmLimits.js.
# LLM_MAX_PROMPT_CHARS="200000"
# LLM_MAX_MESSAGE_CHARS="200000"
# LLM_MAX_CHAT_MESSAGES="50"

# ─── Transactional email (Resend) ─────────────────────────────────────────────
# Used by services/email.js. Its ONE live caller is services/operatorAlert.js,
# which mails ADMIN_EMAILS when an account-deletion ledger write fails. Without
# RESEND_API_KEY the app runs identically and the send is skipped (logged as a
# no-op); the structured [operator-alert] stderr record is emitted either way.
# There is no general "error report email" path -- errorReporter was removed.
# RESEND_API_KEY="re_your_resend_key"
# EMAIL_FROM="GeneMap <noreply@genemap.app>"
# Recipients are ADMIN_EMAILS (see above), NOT a dedicated error address.
# ERROR_REPORT_EMAIL is read NOWHERE in the tree -- setting it does nothing.

# ─── Redis (optional) ─────────────────────────────────────────────────────────
# Shared rate-limit store so limits are enforced across API instances
# (horizontal scaling). Unset = per-instance in-memory rate limiting.
# On Railway, reference the Redis service: REDIS_URL=${{Redis.REDIS_URL}}
# A Redis outage NEVER breaks requests — rate limiting fails open.
# REDIS_URL="redis://default:password@localhost:6379"

# ─── Error tracking ───────────────────────────────────────────────────────────
# THERE IS NO ERROR TRACKING. config/sentry.js and apps/web/lib/sentry.js are
# deliberate no-op stubs (initSentry() returns false, captureException() is
# empty) and neither imports @sentry/*. SENTRY_DSN, VITE_SENTRY_DSN and
# SENTRY_TRACES_SAMPLE_RATE are read NOWHERE -- setting any of them does
# NOTHING. External browser exception export is disabled on purpose: error
# messages and stacks can carry user text, which the publication boundary
# forbids leaving the deployment. Do not document these as functional knobs.

# ─── Misc ─────────────────────────────────────────────────────────────────────
ADMIN_EMAILS="ops@example.com"
NODE_ENV="development"
PORT=3000
HOST="0.0.0.0"
LOG_LEVEL="info"
# CSRF_SECRET="optional; double-submit cookie does not strictly need it"

# ─── Signup free trial (always on by default; self-expiring) ─────────────────
# Every newly-registered user automatically gets an admin_granted Subscription
# comp window starting at signup, via the same mechanism as the admin
# "grant free period" feature. ON by default — no config needed. Flip these in
# the Railway dashboard to tune/disable with no deploy.
# SIGNUP_TRIAL_ENABLED="true"    # "false"/"off"/"0"/"no"/"none" to disable
# SIGNUP_TRIAL_PERIOD="week"     # "week" (7d, default) | "month" (30d) | "none"
