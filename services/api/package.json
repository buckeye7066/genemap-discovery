{
  "name": "@genemap/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "corepack pnpm prepare:runtime && node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "lint": "eslint \"src/**/*.js\"",
    "typecheck": "node --check src/index.js && node --check src/config/env.js && node --check ../../scripts/start-eva-api.mjs",
    "test": "vitest run && node --test ../../scripts/__tests__/start-eva-api.test.mjs",
    "test:integration": "vitest run src/__tests__/postgres-integration.test.js src/__tests__/advertising-postgres.test.js",
    "test:watch": "vitest",
    "prepare:runtime": "corepack pnpm --filter @genemap/shared build && corepack pnpm db:generate",
    "start:eva": "corepack pnpm prepare:runtime && node ../../scripts/start-eva-api.mjs",
    "stop:eva": "node ../../scripts/stop-eva-api.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@fastify/compress": "^8.0.1",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.1.1",
    "@genemap/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^5.1.1",
    "fastify": "^5.12.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.104.0",
    "resend": "^6.25.0",
    "sharp": "^0.35.4",
    "stripe": "^17.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.20.0",
    "prisma": "^6.19.3",
    "vitest": "^4.1.11"
  }
}
