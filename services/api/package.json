{
  "name": "@genemap/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "lint": "eslint \"src/**/*.js\"",
    "typecheck": "node --check src/index.js && node --check src/config/env.js",
    "test": "vitest run",
    "test:integration": "vitest run src/__tests__/postgres-integration.test.js",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@fastify/compress": "^8.0.1",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.1.1",
    "@genemap/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.65.0",
    "bcrypt": "^5.1.1",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.104.0",
    "resend": "^6.17.2",
    "stripe": "^17.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.20.0",
    "prisma": "^6.19.3",
    "vitest": "^3.0.0"
  }
}
