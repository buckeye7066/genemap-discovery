{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @genemap/shared build && pnpm --filter @genemap/web build && node scripts/build-mobile-bundle.mjs",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://genemap-api-production.up.railway.app/auth/:path*"
    },
    {
      "source": "/billing/:path*",
      "destination": "https://genemap-api-production.up.railway.app/billing/:path*"
    },
    {
      "source": "/education/:path*",
      "destination": "https://genemap-api-production.up.railway.app/education/:path*"
    },
    {
      "source": "/llm/:path*",
      "destination": "https://genemap-api-production.up.railway.app/llm/:path*"
    },
    {
      "source": "/genomics/:path*",
      "destination": "https://genemap-api-production.up.railway.app/genomics/:path*"
    },
    {
      "source": "/entities/:path*",
      "destination": "https://genemap-api-production.up.railway.app/entities/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://genemap-api-production.up.railway.app/admin/:path*"
    },
    {
      "source": "/account/:path*",
      "destination": "https://genemap-api-production.up.railway.app/account/:path*"
    },
    {
      "source": "/assistants/:path*",
      "destination": "https://genemap-api-production.up.railway.app/assistants/:path*"
    },
    {
      "source": "/report-client-error",
      "destination": "https://genemap-api-production.up.railway.app/report-client-error"
    },
    {
      "source": "/health/:path*",
      "destination": "https://genemap-api-production.up.railway.app/health/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://genemap-api-production.up.railway.app/healthz"
    },
    {
      "source": "/readyz",
      "destination": "https://genemap-api-production.up.railway.app/readyz"
    },
    {
      "source": "/((?!assets/|icons/|mobile/|ocr/|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://genemap-api-production.up.railway.app; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ocr/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/mobile/latest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/mobile/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
