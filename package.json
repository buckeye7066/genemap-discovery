{
  "name": "genemap-discovery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0 <10"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @genemap/api --filter @genemap/web dev",
    "dev:api": "corepack pnpm --filter @genemap/api dev",
    "dev:web": "corepack pnpm --filter @genemap/web dev",
    "build": "corepack pnpm -r build",
    "build:api": "corepack pnpm --filter @genemap/api build",
    "build:web": "corepack pnpm --filter @genemap/web build",
    "dev:desktop": "corepack pnpm --filter @genemap/desktop dev",
    "build:desktop": "corepack pnpm build:web && corepack pnpm --filter @genemap/desktop build",
    "build:desktop:win": "corepack pnpm build:web && corepack pnpm --filter @genemap/desktop build:win",
    "build:desktop:mac": "corepack pnpm build:web && corepack pnpm --filter @genemap/desktop build:mac",
    "test": "corepack pnpm -r test",
    "test:api": "corepack pnpm --filter @genemap/api test",
    "test:api:integration": "corepack pnpm --filter @genemap/api test:integration",
    "test:shared": "corepack pnpm --filter @genemap/shared test",
    "lint": "corepack pnpm --filter @genemap/web lint && corepack pnpm --filter @genemap/api lint",
    "lint:api": "corepack pnpm --filter @genemap/api lint",
    "typecheck": "corepack pnpm --filter @genemap/shared build && corepack pnpm --filter @genemap/web typecheck && corepack pnpm --filter @genemap/shared typecheck && corepack pnpm --filter @genemap/api typecheck && node --check scripts/verify-production-launch.mjs",
    "audit": "corepack pnpm audit --audit-level=low",
    "launch:verify": "node scripts/verify-production-launch.mjs",
    "release:check": "corepack pnpm install --frozen-lockfile && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm --filter @genemap/shared build && corepack pnpm build:web && corepack pnpm run audit",
    "db:generate": "corepack pnpm --filter @genemap/api db:generate",
    "db:push": "corepack pnpm --filter @genemap/api db:push",
    "db:migrate": "corepack pnpm --filter @genemap/api db:migrate",
    "db:migrate:deploy": "corepack pnpm --filter @genemap/api db:migrate:deploy",
    "db:studio": "corepack pnpm --filter @genemap/api db:studio"
  },
  "pnpm": {
    "overrides": {
      "tar": "7.5.17",
      "minimatch": ">=3.1.4",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
      "qs": "6.15.3",
      "@babel/core": "7.29.7",
      "ip-address": "10.2.0",
      "js-yaml": "4.3.0",
      "@tootallnate/once": ">=3.0.1",
      "rollup": ">=4.59.0",
      "effect@<3.20.0": ">=3.20.0",
      "picomatch": ">=4.0.4",
      "defu@<=6.1.4": ">=6.1.5",
      "postcss@<8.5.10": ">=8.5.10",
      "fast-uri@<=3.1.1": ">=3.1.2",
      "fastify@>=5.3.2 <=5.8.4": ">=5.8.5",
      "brace-expansion@>=4.0.0 <5.0.5": ">=5.0.5",
      "lodash@<=4.17.23": ">=4.18.0",
      "vitest@<3.2.6": ">=3.2.6 <4",
      "vite@>=6.0.0 <=6.4.1": ">=6.4.2 <7",
      "flatted@<=3.4.1": ">=3.4.2",
      "@xmldom/xmldom@<0.8.12": ">=0.8.12",
      "esbuild@<=0.24.2": ">=0.25.0",
      "react-router@>=7.0.0 <7.18.0": ">=7.18.0",
      "react-router-dom@>=7.0.0 <7.18.0": ">=7.18.0",
      "tmp@<0.2.6": ">=0.2.6",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0"
  }
}
