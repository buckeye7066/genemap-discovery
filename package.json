{
  "name": "genemap-discovery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0 <10"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @genemap/api --filter @genemap/web dev",
    "dev:api": "corepack pnpm --filter @genemap/api dev",
    "dev:web": "corepack pnpm --filter @genemap/web dev",
    "build": "corepack pnpm -r build",
    "build:api": "corepack pnpm --filter @genemap/api build",
    "build:web": "corepack pnpm --filter @genemap/web build",
    "build:mobile-bundle": "node scripts/build-mobile-bundle.mjs",
    "build:web:deploy": "corepack pnpm --filter @genemap/shared build && corepack pnpm --filter @genemap/web build && node scripts/build-mobile-bundle.mjs",
    "dev:desktop": "corepack pnpm --filter @genemap/desktop dev",
    "build:desktop": "corepack pnpm build:web && corepack pnpm --filter @genemap/desktop build",
    "build:desktop:win": "corepack pnpm build:web && corepack pnpm --filter @genemap/desktop build:win",
    "build:desktop:mac": "corepack pnpm build:web && corepack pnpm --filter @genemap/desktop build:mac",
    "test": "corepack pnpm -r test",
    "test:api": "corepack pnpm --filter @genemap/api test",
    "test:api:integration": "corepack pnpm --filter @genemap/api test:integration",
    "test:shared": "corepack pnpm --filter @genemap/shared test",
    "lint": "corepack pnpm --filter @genemap/web lint && corepack pnpm --filter @genemap/api lint && eslint \"ops/**/*.mjs\"",
    "lint:api": "corepack pnpm --filter @genemap/api lint",
    "typecheck": "corepack pnpm --filter @genemap/shared build && corepack pnpm --filter @genemap/web typecheck && corepack pnpm --filter @genemap/shared typecheck && corepack pnpm --filter @genemap/api typecheck && node --check ops/closure-ledger/store.mjs && node --check ops/closure-ledger/server.mjs && corepack pnpm launch:verify:selftest",
    "audit": "node scripts/verify-security-exceptions.mjs && corepack pnpm audit --audit-level=low",
    "launch:verify": "node scripts/verify-production-launch.mjs",
    "launch:verify:selftest": "node scripts/verify-production-launch.mjs --self-test",
    "release:check": "corepack pnpm install --frozen-lockfile && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm test:backup && corepack pnpm test:ledger && corepack pnpm launch:verify:selftest && corepack pnpm --filter @genemap/shared build && corepack pnpm build:web && node scripts/verify-publication-bundle.mjs && corepack pnpm run audit",
    "db:generate": "corepack pnpm --filter @genemap/api db:generate",
    "db:push": "corepack pnpm --filter @genemap/api db:push",
    "db:migrate": "corepack pnpm --filter @genemap/api db:migrate",
    "db:migrate:deploy": "corepack pnpm --filter @genemap/api db:migrate:deploy",
    "db:studio": "corepack pnpm --filter @genemap/api db:studio",
    "test:backup": "node --test scripts/__tests__/backup-snapshot.test.mjs scripts/__tests__/monitor-railway-deployment.test.mjs scripts/__tests__/publish-android-release.test.mjs scripts/__tests__/build-mobile-bundle.test.mjs scripts/__tests__/wait-for-live-release.test.mjs",
    "test:ledger": "node --test ops/closure-ledger/__tests__/closure-ledger.test.mjs",
    "memory:startup": "node scripts/obsidian-memory.mjs startup",
    "memory:health": "node scripts/obsidian-memory.mjs health",
    "memory:recall": "node scripts/obsidian-memory.mjs recall",
    "memory:note": "node scripts/obsidian-memory.mjs note",
    "predev": "npm run memory:startup",
    "prestart": "npm run memory:startup",
    "prebuild": "npm run memory:startup"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-qwww-vcr4-c8h2"
      ]
    },
    "overrides": {
      "tar@<=7.5.20": "7.5.21",
      "minimatch": ">=3.1.4",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
      "qs": ">=6.16.0",
      "@babel/core": "7.29.7",
      "ip-address": "10.2.0",
      "js-yaml": ">=4.3.1",
      "nanoid@<3.3.17": ">=3.3.17",
      "nanoid@>=4.0.0 <5.1.6": ">=5.1.6",
      "@tootallnate/once": ">=3.0.1",
      "rollup": ">=4.59.0",
      "effect@<3.20.0": ">=3.20.0",
      "picomatch": ">=4.0.4",
      "defu@<=6.1.4": ">=6.1.5",
      "postcss@<8.5.23": ">=8.5.23",
      "postcss-selector-parser@<6.1.3": ">=6.1.3",
      "fast-uri@<3.1.6": "3.1.6",
      "fast-uri@>=4.0.0 <4.1.3": ">=4.1.3",
      "find-my-way@<=9.6.0": "9.7.0",
      "fastify@>=5.3.2 <=5.8.4": ">=5.8.5",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "builder-util-runtime@<9.7.0": "9.7.0",
      "app-builder-lib@<26.15.0": "26.15.3",
      "electron-builder-squirrel-windows@<26.15.3": "26.15.3",
      "lodash@<=4.17.23": ">=4.18.0",
      "vitest@<3.2.6": ">=3.2.6 <4",
      "vite@>=6.0.0 <=6.4.1": ">=6.4.2 <7",
      "flatted@<=3.4.1": ">=3.4.2",
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "@xmldom/xmldom@>=0.9.0 <0.9.12": ">=0.9.12",
      "esbuild@<=0.24.2": ">=0.25.0",
      "react-router@>=7.0.0 <7.18.0": ">=7.18.0",
      "react-router-dom@>=7.0.0 <7.18.0": ">=7.18.0",
      "tmp@<0.2.6": ">=0.2.6",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "uuid@<11.1.1": ">=11.1.1",
      "deepmerge-ts@<8.0.0": "8.0.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "adm-zip": "^0.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^15.14.0"
  }
}
